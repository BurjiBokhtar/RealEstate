NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required to create/delete staff accounts (Настройки -> Сотрудники).
# Creating a user is an admin-level Supabase Auth operation, so it runs
# server-side with the service role key -- without it /api/admin/users
# rejects every request and the page just reports that Supabase isn't
# configured.
#
# Supabase Dashboard -> Project Settings -> API -> Project API keys ->
# "service_role" -> Reveal -> copy. Set the same value in Vercel:
# Project Settings -> Environment Variables -> SUPABASE_SERVICE_ROLE_KEY.
#
# SECRET: this key bypasses every RLS policy. Never prefix it with
# NEXT_PUBLIC_ (that ships it to the browser) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Required for /api/cron/* routes -- without it those routes reject every
# request (including Vercel's own scheduled trigger). Generate any random
# string and set the same value in Vercel: Project Settings -> Environment
# Variables -> CRON_SECRET. Vercel automatically sends it as a Bearer token
# when invoking cron jobs defined in vercel.json.
CRON_SECRET=
